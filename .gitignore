# Build artifacts
*.o
*.a
*.so
*.dylib

# Freestanding PE/COFF link artifacts (make freestanding-link)
keel_freestanding*.efi
keel_freestanding*.lib

# Integration test/smoke binaries (extensionless; sources are .c)
integrations/*/link_smoke
integrations/uefi/mock_efi_test
integrations/uefi/host_map_test
integrations/nghttp2/e2e/test_roundtrip
integrations/nghttp2/e2e/e2e_socket
integrations/nghttp2/e2e/interop_server
integrations/nghttp2/e2e/client_probe
integrations/nghttp2/e2e/alpn_server
integrations/nghttp2/e2e/alpn_client
integrations/openssl/e2e/tls_e2e
integrations/mbedtls/e2e/tls_e2e
integrations/libressl/e2e_libressl
integrations/boringssl/e2e_boringssl
integrations/*/*.dSYM

# Example binaries (extensionless; sources are .c, docs are .md)
examples/*
!examples/*.c
!examples/*.md
# opt-in BYO lwIP reference (sources/config, not built by default)
!examples/lwip/

# Test binaries
tests/test_*
!tests/test_*.c
# Smoke binaries (all backends: tcp/udp/dns + pollcomp/iocp/iouring + their tls/ws/async
# variants), incl. .exe and macOS .dSYM bundles. Sources (.c) stay tracked.
tests/smoke_*
!tests/smoke_*.c

# Freestanding host mock harness binaries (sources .c stay tracked; make rm's them post-run)
tests/freestanding_harness
tests/freestanding_dns_harness

# Benchmark binary
bench/bench_server

# Fuzz binaries + instrumented-lib artifacts (corpus seeds ARE committed)
fuzz/fuzz_parser
fuzz/fuzz_multipart
fuzz/fuzz_websocket
fuzz/fuzz_response_parser
fuzz/fuzz_dns
fuzz/fuzz_proxy
fuzz/fuzz_url
fuzz/fuzz_decompress
fuzz/crash-*
fuzz/oom-*
fuzz/timeout-*
libkeel_fuzz.a
*.fuzz.o

# Generated API docs
docs/api/
site/build/

# Debug/profiling
*.dSYM/
*.gcda
*.gcno
*.gcov
coverage.info
coverage_html/

# Generated files
*.d
keel.pc

